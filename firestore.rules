rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // In a real app, you'd check a dedicated 'admins' collection or custom claim
      // For this demo/setup, we'll allow the user who set up the project (yesom6218@naver.com)
      return isSignedIn() && (request.auth.token.email == 'yesom6218@naver.com' && request.auth.token.email_verified == true);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidContactRequest(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20 &&
             (data.email == null || (data.email is string && data.email.size() <= 100)) &&
             (data.message == null || (data.message is string && data.message.size() <= 2000)) &&
             data.createdAt == request.time;
    }

    match /contactRequests/{requestId} {
      allow create: if isValidId(requestId) && isValidContactRequest(incoming());
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
